---
layout: base.njk
---
<article class="post">
  <div class="post-header">
    <p class="eyebrow">{{ date | readableDate }}{% if tags %} · {{ tags | join(", ") }}{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if description %}<p class="post-dek">{{ description }}</p>{% endif %}
  </div>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <div class="post-footer">
    <a href="/blog/">← Back to all posts</a>
  </div>
</article>
